# LLM providers — how you supply secrets is up to your app.
# The harness optional helper `bootstrapProvidersFromEnv()` reads these:

# Google AI Studio
GEMINI_API_KEY=

# Cursor SDK
CURSOR_API_KEY=

# OpenAI
OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Anthropic
ANTHROPIC_API_KEY=

# Multiple OpenAI-compatible backends (recommended)
# OPENAI_COMPATIBLE_PROVIDERS=[{"id":"lm-studio","baseUrl":"http://127.0.0.1:1234/v1","apiKeyEnv":"LM_STUDIO_API_KEY"},{"id":"ollama","baseUrl":"http://127.0.0.1:11434/v1"}]
# LM_STUDIO_API_KEY=

# Single OpenAI-compatible shorthand (registers id "openai-compatible")
# OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:1234/v1
# OPENAI_COMPATIBLE_API_KEY=

# Optional model defaults
# AGENT_ENV_MODEL=gemini:gemini-2.5-flash
# AGENT_ENV_CONS_MODEL=lm-studio:local-model
# AGENT_ENV_APP_NAME=agent-env
# AGENT_ENV_USER_ID=local-user

# Collector connectors
# GH_REPO=owner/name          # scope for createGithubGhConnector (auth via `gh auth`)
# AGENT_ENV_HTTP_DEMO=0       # disable JSONPlaceholder demo HTTP source
