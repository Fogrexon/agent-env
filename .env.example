# Used by agents/dev-env (@agent-env/repo-env) in THIS repo.
# Not read by @agent-env/llm or @agent-env/harness.

# Cursor SDK (demo agents default to this when tools are not required)
CURSOR_API_KEY=

# Google AI Studio (Gemini Developer API)
GEMINI_API_KEY=

# Vertex AI — Gemini via Application Default Credentials
# (used when GEMINI_API_KEY is unset and GOOGLE_GENAI_USE_VERTEXAI=true)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# OpenAI
OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Anthropic API
ANTHROPIC_API_KEY=

# Vertex AI — Claude via Application Default Credentials
# (used when ANTHROPIC_API_KEY is unset and ANTHROPIC_USE_VERTEXAI=true)
# ANTHROPIC_USE_VERTEXAI=true
# ANTHROPIC_VERTEX_PROJECT_ID=   # optional; falls back to GOOGLE_CLOUD_PROJECT
# CLOUD_ML_REGION=us-east5       # or GOOGLE_CLOUD_LOCATION

# Multiple OpenAI-compatible backends
# OPENAI_COMPATIBLE_PROVIDERS=[{"id":"lm-studio","baseUrl":"http://127.0.0.1:1234/v1","apiKeyEnv":"LM_STUDIO_API_KEY"},{"id":"ollama","baseUrl":"http://127.0.0.1:11434/v1"}]
# LM_STUDIO_API_KEY=

# Single OpenAI-compatible shorthand (registers id "openai-compatible")
# OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:1234/v1
# OPENAI_COMPATIBLE_API_KEY=

# Optional model defaults (read by agents, not by packages/llm)
# AGENT_ENV_MODEL=cursor:auto
# AGENT_ENV_PROS_MODEL=cursor:auto
# AGENT_ENV_CONS_MODEL=cursor:auto
# AGENT_ENV_SYNTH_MODEL=cursor:auto
# AGENT_ENV_CURSOR_MODEL=auto
# AGENT_ENV_APP_NAME=agent-env
# AGENT_ENV_USER_ID=local-user

# agents/collector wiring
# GH_REPO=owner/name
# AGENT_ENV_HTTP_DEMO=0
# TAVILY_API_KEY=
# AGENT_ENV_GROK_X=0
# AGENT_ENV_GROK_MODEL=
