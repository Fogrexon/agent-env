# LLM providers (set at least one)

# Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Cursor SDK: https://cursor.com/dashboard/api
CURSOR_API_KEY=

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Anthropic: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI-compatible local / self-hosted (LM Studio, Ollama, vLLM, …)
# LM Studio default: http://127.0.0.1:1234/v1
# Ollama OpenAI compat: http://127.0.0.1:11434/v1
OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_API_KEY=
# Aliases also accepted:
# LM_STUDIO_BASE_URL=
# LM_STUDIO_API_KEY=

# Optional defaults for the harness
# AGENT_ENV_MODEL=gemini:gemini-2.5-flash
# AGENT_ENV_CURSOR_MODEL=composer-2
# AGENT_ENV_OPENAI_MODEL=gpt-4o-mini
# AGENT_ENV_ANTHROPIC_MODEL=claude-sonnet-4-5
# AGENT_ENV_OPENAI_COMPATIBLE_MODEL=local-model
# AGENT_ENV_PROS_MODEL=gemini:gemini-2.5-flash
# AGENT_ENV_CONS_MODEL=openai-compatible:local-model
# AGENT_ENV_SYNTH_MODEL=anthropic:claude-sonnet-4-5
# AGENT_ENV_APP_NAME=agent-env
# AGENT_ENV_USER_ID=local-user
