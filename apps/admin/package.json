{
  "name": "@agent-env/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local admin console: AgentParams forms + run control plane",
  "scripts": {
    "dev": "concurrently -k -n api,ui -c blue,green \"npm run dev:api\" \"npm run dev:ui\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:ui": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "start": "node dist-server/index.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@agent-env/harness": "0.1.0",
    "@agent-env/llm": "0.1.0",
    "@agent-env/repo-env": "0.1.0",
    "@agent-env/shared": "0.1.0",
    "@carbon/icons-react": "^11.85.0",
    "@carbon/react": "^1.113.0",
    "@dagrejs/dagre": "^3.0.0",
    "@google/adk": "^1.4.0",
    "@uiw/react-md-editor": "^4.1.1",
    "@xyflow/react": "^12.11.2",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "croner": "^10.0.1",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1",
    "sass": "^1.102.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@types/busboy": "^1.5.4",
    "@types/cors": "^2.8.19",
    "@types/dagre": "^0.7.54",
    "@types/express": "^5.0.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "storybook": "^10.5.7",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^7.0.5"
  }
}
