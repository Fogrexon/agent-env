{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agent-env/security-audit/evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "perFix", "residualRisks"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["APPROVE", "REVISE", "REJECT"]
    },
    "summary": {
      "type": "string",
      "minLength": 8,
      "maxLength": 1200
    },
    "perFix": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["findingId", "accepted", "notes"],
        "properties": {
          "findingId": {
            "type": "string",
            "pattern": "^F\\d+$"
          },
          "accepted": { "type": "boolean" },
          "notes": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        }
      }
    },
    "residualRisks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
