        {
          "name": "emit_cons_rebuttal_1",
          "version": "1.0",
          "riskClass": "T0",
          "sideEffect": "none",
          "idempotency": "supported"
        },
        {
          "name": "emit_pros_rebuttal_2",
          "version": "1.0",
          "riskClass": "T0",
          "sideEffect": "none",
          "idempotency": "supported"
        },
        {
          "name": "emit_cons_rebuttal_2",
          "version": "1.0",
          "riskClass": "T0",
          "sideEffect": "none",
          "idempotency": "supported"
        }
      ]
    },
    "budget": {
      "maxToolCalls": 100,
      "maxWallSeconds": 1200
    },
    "evaluation": { "ref": "./evaluation.json" }
  }
