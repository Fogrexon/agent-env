{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agent-env/runspec-demo/result",
  "type": "object",
  "additionalProperties": true,
  "required": ["fromAgent", "toAgent", "outputSchema", "payload", "digest"],
  "properties": {
    "fromAgent": { "type": "string", "minLength": 1 },
    "toAgent": { "type": "string", "minLength": 1 },
    "outputSchema": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "minLength": 16 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary", "measured"],
      "properties": {
        "status": { "type": "string", "const": "verified" },
        "summary": {
          "type": "string",
          "minLength": 20,
          "maxLength": 600
        },
        "measured": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 4,
            "maxLength": 160
          }
        }
      }
    }
  }
}
