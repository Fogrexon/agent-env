{
  "apiVersion": "agent.platform/v1",
  "kind": "RunSpec",
  "metadata": {
    "tenantId": "local-demo",
    "idempotencyKey": "runspec-demo-v1"
  },
  "spec": {
    "task": {
      "taskId": "demo-brief",
      "revision": "2026-07-24",
      "objective": "Summarize what a RunSpec-driven harness should measure for one coding-style agent run.",
      "successCriteria": [
        {
          "type": "contains",
          "text": "verified",
          "caseInsensitive": true
        }
      ]
    },
    "harness": {
      "policyRef": "harness://phase-a/bounded-loop-v1",
      "maxSteps": 12,
      "maxRepairs": 0
    },
    "model": {
      "primary": {
        "provider": "gemini",
        "model": "gemini-2.5-flash"
      }
    },
    "environment": {
      "backend": "none",
      "networkPolicy": "deny"
    },
    "tools": {
      "allow": [
        {
          "name": "echo_note",
          "version": "1.0",
          "riskClass": "T0",
          "sideEffect": "none",
          "idempotency": "supported"
        },
        {
          "name": "propose_publish",
          "version": "1.0",
          "riskClass": "T2",
          "sideEffect": "irreversible",
          "idempotency": "required"
        }
      ]
    },
    "budget": {
      "maxToolCalls": 20,
      "maxWallSeconds": 180
    },
    "evaluation": {
      "graderVersion": "demo-contains-v1",
      "repetitions": 1
    }
  }
}
