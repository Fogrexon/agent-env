{
  "apiVersion": "agent.platform/v1",
  "kind": "RunSpec",
  "metadata": {
    "tenantId": "local-demo",
    "idempotencyKey": "runspec-demo-v2"
  },
  "spec": {
    "task": {
      "taskId": "demo-brief",
      "revision": "2026-07-25-v2",
      "objective": "Summarize what a RunSpec-driven harness should measure for one coding-style agent run.",
      "outputSchemaRef": "agents/runspec-demo/schemas/result.schema.json"
    },
    "harness": {
      "policyRef": "harness://phase-a/bounded-loop-v2",
      "maxSteps": 12,
      "maxRepairs": 1
    },
    "model": {
      "primary": {
        "provider": "cursor",
        "model": "auto"
      },
      "allowed": [
        {
          "provider": "cursor",
          "model": "auto"
        },
        {
          "provider": "gemini",
          "model": "gemini-3.6-flash"
        }
      ]
    },
    "environment": {
      "backend": "none",
      "networkPolicy": "deny"
    },
    "tools": {
      "allow": [
        {
          "name": "echo_note",
          "version": "1.0",
          "riskClass": "T0",
          "sideEffect": "none",
          "idempotency": "supported"
        },
        {
          "name": "propose_publish",
          "version": "1.0",
          "riskClass": "T2",
          "sideEffect": "irreversible",
          "idempotency": "required"
        },
        {
          "name": "emit_result_handoff",
          "version": "1.0",
          "riskClass": "T0",
          "sideEffect": "none",
          "idempotency": "supported"
        }
      ]
    },
    "budget": {
      "maxToolCalls": 20,
      "maxWallSeconds": 180
    },
    "evaluation": {
      "ref": "./evaluation.json"
    }
  }
}
