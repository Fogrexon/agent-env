{
  "apiVersion": "agent.platform/v1",
  "kind": "RunSpec",
  "metadata": {
    "tenantId": "local-demo",
    "idempotencyKey": "code-exec-v1"
  },
  "spec": {
    "task": {
      "taskId": "code-exec",
      "revision": "2026-07-25",
      "objective": "sum で 1, 2, 3 を足して"
    },
    "harness": {
      "policyRef": "harness://code-exec/v1",
      "maxSteps": 20,
      "maxRepairs": 0
    },
    "model": {
      "primary": { "provider": "cursor", "model": "auto" },
      "allowed": [
        { "provider": "cursor", "model": "auto" },
        { "provider": "gemini", "model": "gemini-3.6-flash" }
      ]
    },
    "environment": {
      "backend": "process",
      "networkPolicy": "deny"
    },
    "tools": {
      "allow": [
        {
          "name": "sum",
          "version": "1.0",
          "riskClass": "T0",
          "sideEffect": "none",
          "idempotency": "supported"
        },
        {
          "name": "run_ts_code",
          "version": "1.0",
          "riskClass": "T2",
          "sideEffect": "reversible",
          "idempotency": "none"
        }
      ]
    },
    "budget": {
      "maxToolCalls": 20,
      "maxWallSeconds": 300
    },
    "evaluation": { "ref": "./evaluation.json" }
  }
}
