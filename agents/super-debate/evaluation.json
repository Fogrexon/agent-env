{
  "apiVersion": "agent.platform/v1",
  "kind": "EvaluationSpec",
  "metadata": { "id": "super-debate", "version": "1" },
  "artifacts": [],
  "graders": [
    {
      "id": "output",
      "kind": "deterministic",
      "ref": "grader://non-empty/v1",
      "config": {}
    },
    {
      "id": "has-conclusion",
      "kind": "deterministic",
      "ref": "grader://contains/v1",
      "config": { "text": "Final conclusion" }
    }
  ],
  "acceptance": {
    "all": [
      { "id": "has-output", "grader": "output", "assertion": "non-empty" },
      { "id": "has-final", "grader": "has-conclusion", "assertion": "contains" }
    ]
  }
}
