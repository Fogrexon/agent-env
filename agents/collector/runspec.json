{
  "apiVersion": "agent.platform/v1",
  "kind": "RunSpec",
  "metadata": {
    "tenantId": "local-demo",
    "idempotencyKey": "collector-brief-v1"
  },
  "spec": {
    "task": {
      "taskId": "multi-source-brief",
      "revision": "2026-07-24",
      "objective": "Prepare a multi-source briefing about customer risk and current API latency for ops + account teams."
    },
    "harness": {
      "policyRef": "harness://collector/fan-out-v1",
      "maxSteps": 24,
      "maxRepairs": 0
    },
    "model": {
      "primary": {
        "provider": "cursor",
        "model": "auto"
      },
      "allowed": [
        {
          "provider": "cursor",
          "model": "auto"
        },
        {
          "provider": "gemini",
          "model": "gemini-3.6-flash"
        }
      ]
    },
    "environment": {
      "backend": "none",
      "networkPolicy": "deny"
    },
    "tools": {
      "allow": [
        {
          "name": "search_kb",
          "version": "1.0",
          "riskClass": "T0",
          "sideEffect": "none",
          "idempotency": "supported"
        },
        {
          "name": "search_crm",
          "version": "1.0",
          "riskClass": "T0",
          "sideEffect": "none",
          "idempotency": "supported"
        },
        {
          "name": "search_status",
          "version": "1.0",
          "riskClass": "T0",
          "sideEffect": "none",
          "idempotency": "supported"
        },
        {
          "name": "search_github",
          "version": "1.0",
          "riskClass": "T0",
          "sideEffect": "none",
          "idempotency": "supported"
        },
        {
          "name": "search_http_posts",
          "version": "1.0",
          "riskClass": "T0",
          "sideEffect": "none",
          "idempotency": "supported"
        },
        {
          "name": "search_web",
          "version": "1.0",
          "riskClass": "T0",
          "sideEffect": "none",
          "idempotency": "supported"
        },
        {
          "name": "search_arxiv",
          "version": "1.0",
          "riskClass": "T0",
          "sideEffect": "none",
          "idempotency": "supported"
        },
        {
          "name": "search_x",
          "version": "1.0",
          "riskClass": "T0",
          "sideEffect": "none",
          "idempotency": "supported"
        }
      ]
    },
    "budget": {
      "maxToolCalls": 40,
      "maxWallSeconds": 600
    },
    "evaluation": {
      "ref": "./evaluation.json"
    }
  }
}
