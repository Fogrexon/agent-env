{
  "apiVersion": "agent.platform/v1",
  "kind": "RunSpec",
  "metadata": {
    "tenantId": "local-demo",
    "idempotencyKey": "collector-brief-v1"
  },
  "spec": {
    "task": {
      "taskId": "multi-source-brief",
      "revision": "2026-07-24",
      "objective": "Prepare a short briefing about customer risk and current API latency for ops + account teams.",
      "successCriteria": [
        {
          "type": "contains",
          "text": "Sources",
          "caseInsensitive": true
        },
        {
          "type": "contains",
          "text": "Recommendation",
          "caseInsensitive": true
        },
        {
          "type": "contains",
          "text": "verified",
          "caseInsensitive": true
        }
      ]
    },
    "harness": {
      "policyRef": "harness://collector/fan-out-v1",
      "maxSteps": 24,
      "maxRepairs": 0
    },
    "model": {
      "primary": {
        "provider": "gemini",
        "model": "gemini-2.5-flash"
      }
    },
    "environment": {
      "backend": "none",
      "networkPolicy": "deny"
    },
    "tools": {
      "allow": [
        {
          "name": "search_kb",
          "version": "1.0",
          "riskClass": "T0",
          "sideEffect": "none",
          "idempotency": "supported"
        },
        {
          "name": "search_crm",
          "version": "1.0",
          "riskClass": "T0",
          "sideEffect": "none",
          "idempotency": "supported"
        },
        {
          "name": "search_status",
          "version": "1.0",
          "riskClass": "T0",
          "sideEffect": "none",
          "idempotency": "supported"
        }
      ]
    },
    "budget": {
      "maxToolCalls": 40,
      "maxWallSeconds": 300
    },
    "evaluation": {
      "graderVersion": "collector-brief-v1",
      "repetitions": 1
    }
  }
}
