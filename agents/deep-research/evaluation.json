{
  "apiVersion": "agent.platform/v1",
  "kind": "EvaluationSpec",
  "metadata": { "id": "deep-research-report", "version": "1" },
  "artifacts": [
    {
      "id": "report",
      "mediaTypes": ["text/markdown"],
      "required": true,
      "minBytes": 2000
    },
    {
      "id": "report",
      "mediaTypes": ["application/pdf"],
      "required": true,
      "minBytes": 500
    }
  ],
  "graders": [
    {
      "id": "artifacts",
      "kind": "deterministic",
      "ref": "grader://artifact-contract/v1",
      "config": {}
    },
    {
      "id": "structure",
      "kind": "deterministic",
      "ref": "grader://document-contract/v1",
      "config": {
        "artifact": "report",
        "sections": [
          "Success criteria check",
          "Sources",
          "Residual uncertainties"
        ]
      }
    }
  ],
  "acceptance": {
    "all": [
      { "id": "files", "grader": "artifacts", "assertion": "present" },
      { "id": "sections", "grader": "structure", "assertion": "sections" }
    ]
  }
}
