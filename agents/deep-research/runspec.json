{
  "apiVersion": "agent.platform/v1",
  "kind": "RunSpec",
  "metadata": {
    "tenantId": "local-demo",
    "idempotencyKey": "deep-research-v4"
  },
  "spec": {
    "task": {
      "taskId": "deep-research-report",
      "revision": "2026-07-28-typed-handoff",
      "objective": "What are the current best practices for securing LLM agent tool-calling, and which mitigations matter most in production?"
    },
    "harness": {
      "policyRef": "harness://deep-research/typed-handoff-v1",
      "maxSteps": 100,
      "maxRepairs": 0
    },
    "model": {
      "primary": {
        "provider": "cursor",
        "model": "auto"
      },
      "allowed": [
        { "provider": "cursor", "model": "auto" },
        { "provider": "gemini", "model": "gemini-3.6-flash" }
      ]
    },
    "environment": {
      "backend": "none",
      "networkPolicy": "unrestricted",
      "egressDomains": []
    },
    "tools": {
      "allow": [
        {
          "name": "search_web",
          "version": "1.0",
          "riskClass": "T0",
          "sideEffect": "none",
          "idempotency": "supported"
        },
        {
          "name": "search_x",
          "version": "1.0",
          "riskClass": "T0",
          "sideEffect": "none",
          "idempotency": "supported"
        },
        {
          "name": "fetch_pages",
          "version": "1.0",
          "riskClass": "T0",
          "sideEffect": "none",
          "idempotency": "supported"
        },
        {
          "name": "register_workspace",
          "version": "1.0",
          "riskClass": "T0",
          "sideEffect": "none",
          "idempotency": "supported"
        },
        {
          "name": "download_url",
          "version": "1.0",
          "riskClass": "T1",
          "sideEffect": "reversible",
          "idempotency": "supported"
        },
        {
          "name": "write_file",
          "version": "1.0",
          "riskClass": "T2",
          "sideEffect": "reversible",
          "idempotency": "supported"
        },
        {
          "name": "markdown_to_pdf",
          "version": "1.0",
          "riskClass": "T1",
          "sideEffect": "reversible",
          "idempotency": "supported"
        },
        {
          "name": "emit_research_scope",
          "version": "1.0",
          "riskClass": "T0",
          "sideEffect": "none",
          "idempotency": "supported"
        },
        {
          "name": "emit_research_plan",
          "version": "1.0",
          "riskClass": "T0",
          "sideEffect": "none",
          "idempotency": "supported"
        },
        {
          "name": "emit_evidence_ledger",
          "version": "1.0",
          "riskClass": "T0",
          "sideEffect": "none",
          "idempotency": "supported"
        },
        {
          "name": "emit_gap_fill",
          "version": "1.0",
          "riskClass": "T0",
          "sideEffect": "none",
          "idempotency": "supported"
        },
        {
          "name": "emit_draft_report",
          "version": "1.0",
          "riskClass": "T0",
          "sideEffect": "none",
          "idempotency": "supported"
        }
      ]
    },
    "budget": {
      "maxToolCalls": 140,
      "maxWallSeconds": 3600
    },
    "evaluation": {
      "ref": "./evaluation.json"
    }
  }
}
