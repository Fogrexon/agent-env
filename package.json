{
  "name": "agent-env",
  "version": "0.1.0",
  "private": true,
  "description": "Type-safe ADK harness with swappable LLM provider adapters",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "agents/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "adk:web": "adk web agents",
    "adk:run": "adk run",
    "run": "tsc -b && tsx scripts/run.ts",
    "admin": "npm run dev -w @agent-env/admin",
    "admin:api": "npm run dev:api -w @agent-env/admin",
    "admin:ui": "npm run dev:ui -w @agent-env/admin",
    "smoke:llm": "tsc -b && tsx scripts/smoke-llm.ts",
    "smoke:runtime": "tsc -b && tsx scripts/smoke-runtime.ts",
    "smoke:connectors": "tsc -b && tsx scripts/smoke-connectors.ts",
    "smoke:connectors:http": "tsc -b && tsx scripts/smoke-connectors-http-gh.ts",
    "smoke:params": "tsc -b && tsx scripts/smoke-params.ts",
    "smoke:progress": "tsc -b && tsx scripts/smoke-progress.ts",
    "smoke:run-history": "tsc -b && tsx scripts/smoke-run-history.ts",
    "smoke:http-download-pdf": "tsc -b && tsx scripts/smoke-http-download-pdf.ts",
    "smoke:media": "tsc -b && tsx scripts/smoke-media.ts",
    "smoke:attachments": "tsc -b && tsx scripts/smoke-attachments.ts",
    "smoke:code-exec": "tsc -b && tsx scripts/smoke-code-exec.ts",
    "smoke:spec-policy": "tsc -b && tsx scripts/smoke-spec-policy.ts",
    "smoke:working-env": "tsc -b && tsx scripts/smoke-working-env.ts",
    "exec:env": "tsc -b && tsx scripts/exec-env.ts",
    "smoke": "npm run smoke:llm && npm run smoke:runtime && npm run smoke:connectors && npm run smoke:connectors:http && npm run smoke:params && npm run smoke:progress && npm run smoke:run-history && npm run smoke:http-download-pdf && npm run smoke:media && npm run smoke:attachments && npm run smoke:code-exec && npm run smoke:spec-policy && npm run smoke:working-env"
  },
  "engines": {
    "node": ">=24.13.0",
    "npm": ">=11.8.0"
  },
  "dependencies": {
    "@google/adk": "^1.4.0",
    "@google/genai": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@google/adk-devtools": "^1.4.0",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
